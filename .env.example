# Plantilla de variables de entorno del dashboard.
# Copiar a .env.local y sustituir todos los placeholders por valores propios.
# No incluir credenciales reales en este archivo ni generar claves aquí.
#
# NOTA: .gitignore ya incluye la excepción (!.env.example); esta plantilla
# no está ignorada. No forzar staging ni commit desde documentación.

# --- Supabase ---
# Si todo el acceso pasa por servidor, no se duplica la URL como NEXT_PUBLIC_*.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Supabase: solo servidor ---
# Preferir una clave service_role real. El runtime acepta una service_role JWT
# o un sb_secret_ opaco real; rechaza claves anon. Nunca exponerla ni prefijarla
# con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-solo-servidor>
# SUPABASE_SECRET_KEY=<secret-key-solo-servidor-si-es-service_role>

# --- Cifrado de datos: solo servidor ---
# Conservar la clave actual y la anterior si se usa rotación; no rotar por azar.
# El esquema remoto y la equivalencia con los datos no están verificados.
ENCRYPTION_SECRET_KEY=<clave-de-cifrado-actual>
ENCRYPTION_SECRET_KEY0=<clave-de-cifrado-anterior-rotacion>

# --- Auth runtime: solo servidor ---
# AUTH_SESSION_SECRET es obligatorio en producción (32+ bytes aleatorios) y debe
# ser estable entre instancias/despliegues del mismo entorno, distinto por entorno.
# La cookie HttpOnly usa dashboard_session.
AUTH_SESSION_SECRET=<secreto-de-sesion-32-bytes>
# Defaults actuales del runtime si se omiten: 8h, 15m, 10 intentos, 15m.
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_BLOCK_SECONDS=900

# --- Kubios: solo servidor ---
# Reutilizar las credenciales existentes de la cuenta del equipo.
KUBIOS_USERNAME=<usuario-cuenta-equipo>
KUBIOS_PASSWORD=<contrasena-cuenta-equipo>
KUBIOS_CLIENT_ID=<cliente-cognito-kubios>
# Opcional. Sin override, se exige el equipo Diabetes Tracker - H2TRAIN.
# KUBIOS_TEAM_ID=<uuid-equipo-autorizado>
# AES-256-GCM: 32 bytes aleatorios codificados en base64. Es una clave nueva
# distinta de ENCRYPTION_SECRET_KEY y del secreto del cron; conservarla estable.
KUBIOS_ENCRYPTION_KEY_V1=<clave-aes-32-bytes-base64>
# Debe coincidir con kubios_sync_cron_secret de Supabase Vault.
KUBIOS_CRON_SECRET=<secreto-cron-aleatorio-independiente>

# --- Fuera de alcance / retirado ---
# No configurar NEXT_PUBLIC_BACKEND_URL ni los endpoints fix-ids/sync-auth.
