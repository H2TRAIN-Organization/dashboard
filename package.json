{
  "name": "dashboard-vercel-fix",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@tailwindcss/oxide": false,
    "unrs-resolver": false
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:https": "next dev --turbopack --experimental-https --experimental-https-key ../ssl/localhost.key --experimental-https-cert ../ssl/localhost.crt",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" scripts/check-layers.mjs vitest.config.mts playwright.config.ts --max-warnings=0",
    "lint:src": "npm run lint",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:kubios": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/kubios-*.test.mjs scripts/test_kubios_auth_client.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "openapi:check": "vitest run tests/contracts/openapi.test.ts",
    "check:layers": "node scripts/check-layers.mjs",
    "check": "npm run typecheck && npm run typecheck:app && npm run lint && npm run check:layers && npm run test",
    "check-db": "node scripts/check_database.js",
    "check-env": "node scripts/check_env.js",
    "setup-https": "bash ../scripts/setup-https-dev.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "cobe": "^0.6.5",
    "echarts": "^6.1.0",
    "input-otp": "^1.5.0",
    "leva": "^0.10.1",
    "liveline": "^0.0.7",
    "lucide-react": "^0.539.0",
    "motion": "^14.13.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "plotly.js-dist-min": "^4.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.22",
    "recharts": "^3.1.2",
    "satori": "^0.63.2",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "torph": "^0.1.3",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "pg": "^8.23.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
