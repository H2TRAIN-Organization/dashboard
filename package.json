{
  "name": "dashboard-vercel-fix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:https": "next dev --turbopack --experimental-https --experimental-https-key ../ssl/localhost.key --experimental-https-cert ../ssl/localhost.crt",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/server/**/*.ts\" \"src/app/api/**/*.ts\" \"tests/**/*.ts\" scripts/check-layers.mjs vitest.config.mts playwright.config.ts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "openapi:check": "vitest run tests/contracts/openapi.test.ts",
    "check:layers": "node scripts/check-layers.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:layers && npm run test",
    "check-db": "node scripts/check_database.js",
    "check-env": "node scripts/check_env.js",
    "setup-https": "bash ../scripts/setup-https-dev.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.539.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.1.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
