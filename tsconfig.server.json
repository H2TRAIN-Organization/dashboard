{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": [
    "src/server/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.mts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "build",
    "coverage",
    "playwright-report",
    "test-results",
    "pi-mqtt-agent",
    "kub-kubioscloud-demo",
    "Uploader"
  ]
}
